+// Whether the logind session is a display-manager greeter session.
+// Greeter usernames drift as display managers rename their greeter account;
+// the session class does not, and greetd/GDM/SDDM all set it.
+pub fn is_greeter_session(session: &str) -> bool {
+    if let Ok(output) = run_loginctl(Some(vec!["show-session", "-p", "Class", session])) {
+        String::from_utf8_lossy(&output.stdout).trim() == "Class=greeter"
+    } else {
+        false
+    }
 }
 
