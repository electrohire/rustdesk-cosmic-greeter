+// `XDG_SESSION_TYPE` in a NUL-separated process environment (the format of
+// /proc/<pid>/environ), lowercased. None when unset or empty.
+fn session_type_from_environ(environ: &[u8]) -> Option<String> {
+    for entry in environ.split(|b| *b == 0) {
+        if let Some(value) = entry.strip_prefix(b"XDG_SESSION_TYPE=") {
+            let value = String::from_utf8_lossy(value).trim().to_lowercase();
+            if !value.is_empty() {
+                return Some(value);
+            }
+        }
+    }
+    None
+}
+
+// The session type the session leader was started with, read from its own
+// environment. This is the only place the type survives when logind reports
+// the session Type as "tty"/"unspecified" (greeter sessions commonly land
+// there): a service-spawned process runs outside the session it asks about,
+// so its own environment says nothing about that session. Reading the
+// leader's environment needs root or the session user's uid, which are
+// exactly the callers that resolve session types; degrade to None on any
+// failure.
+fn get_session_type_from_leader(session: &str) -> Option<String> {
+    let output = run_loginctl(Some(vec!["show-session", "-p", "Leader", session])).ok()?;
+    let leader = String::from_utf8_lossy(&output.stdout)
+        .replace("Leader=", "")
+        .trim()
+        .to_owned();
+    if leader.parse::<u32>().is_err() {
+        return None;
+    }
+    let environ = std::fs::read(format!("/proc/{}/environ", leader)).ok()?;
+    session_type_from_environ(&environ)
+}
