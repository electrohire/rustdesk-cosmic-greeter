+    #[test]
+    fn test_session_type_from_environ() {
+        let environ = b"DISPLAY=:0\0XDG_SESSION_TYPE=wayland\0HOME=/var/lib/cosmic-greeter\0";
+        assert_eq!(
+            session_type_from_environ(environ),
+            Some("wayland".to_owned())
+        );
+        // The value is lowercased, matching get_display_server_of_session.
+        assert_eq!(
+            session_type_from_environ(b"XDG_SESSION_TYPE=Wayland\0"),
+            Some("wayland".to_owned())
+        );
+        // Unset, empty, and merely similar keys do not resolve a type.
+        assert_eq!(session_type_from_environ(b"DISPLAY=:0\0"), None);
+        assert_eq!(session_type_from_environ(b"XDG_SESSION_TYPE=\0"), None);
+        assert_eq!(
+            session_type_from_environ(b"XDG_SESSION_TYPEX=wayland\0MY_XDG_SESSION_TYPE=x11\0"),
+            None
+        );
+    }
